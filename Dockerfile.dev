FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Copier le Maven Wrapper et la configuration
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

RUN chmod +x mvnw

# Précharger les dépendances
RUN ./mvnw -B dependency:go-offline

# Copier le code source
COPY src/ src/

# Compiler le projet
RUN ./mvnw -B -DskipTests compile

EXPOSE 8080

CMD ["./mvnw", "spring-boot:run"]
